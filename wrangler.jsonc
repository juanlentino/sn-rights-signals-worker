{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sn-rights-signals",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-08",
  // Only ingress is the juanlentino.com route below. Without this, CF defaults
  // BOTH the workers.dev route and the preview URL to enabled — an
  // unauthenticated public entry point outside the zone. Lock ingress to the zone.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Weekly (Monday, off-hour) crawler-list drift check — see
  // src/crawler-list-sync.mjs. Low frequency on purpose: Cloudflare's
  // managed default doesn't change often, and this only needs to catch
  // drift before it's stale for long, not in real time.
  "triggers": { "crons": ["23 7 * * 1"] },
  // A single wildcard route: this Worker does its own pathname dispatch
  // (see src/index.mjs) rather than registering one Cloudflare route per
  // surface. More-specific routes on sn-analytics/sn-login-guard/sn-provenance
  // still take precedence over this wildcard (Cloudflare route-matching:
  // "more specific routes take precedence over wildcard routes").
  // v1.4.0: machine-readership aggregates (family + surface class + day only —
  // no IPs, no raw UAs; see src/machine-readers.mjs for the privacy contract).
  // v1.11.0: SN_MR_RIGHTS is the RULE 3 full-fidelity stream — complete UA,
  // path, Accept and timestamp, but ONLY for rights-surface reads (~80 per
  // 30 days against 17,463 total). A separate dataset because it must never be
  // summed with the aggregate one and answers a different question.
  "analytics_engine_datasets": [
    { "binding": "SN_MR", "dataset": "sn_machine_readers" },
    { "binding": "SN_MR_RIGHTS", "dataset": "sn_machine_readers_rights" }
  ],
  "routes": [
    { "pattern": "juanlentino.com/*", "zone_name": "juanlentino.com" }
  ]
}
