{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sn-rights-signals",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-08",
  // Only ingress is the juanlentino.com route below. Without this, CF defaults
  // BOTH the workers.dev route and the preview URL to enabled — an
  // unauthenticated public entry point outside the zone. Lock ingress to the zone.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // esbuild's --keep-names (wrangler's default: true) rewrites nested named
  // function expressions to `fn = __name(fn, "fn")` so Function.prototype.name
  // survives minification. That helper call lands INSIDE the function bodies
  // this repo composes into the served /webmcp/bridge.js asset via toString()
  // (src/webmcp-bridge.mjs) — so the SHIPPED bytes reference a bundle-scope
  // `__name` that does not exist in a browser. function.name is not
  // load-bearing anywhere in webmcp-bridge-client.mjs (verified: the only
  // `.name` access in that file is Error#name, unrelated) or webmcp-bridge.mjs,
  // so disabling this repo-wide is free. Kept alongside a defensive `__name`
  // shim prepended to BRIDGE_SOURCE itself (src/webmcp-bridge.mjs) as
  // defense-in-depth against a future esbuild-injected helper this flag
  // doesn't cover — see scripts/webmcp-bridge-bundle-gate.mjs, which builds
  // this exact module through wrangler's own bundler to catch a regression.
  "keep_names": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Weekly (Monday, off-hour) crawler-list drift check — see
  // src/crawler-list-sync.mjs. Low frequency on purpose: Cloudflare's
  // managed default doesn't change often, and this only needs to catch
  // drift before it's stale for long, not in real time.
  "triggers": { "crons": ["23 7 * * 1"] },
  // A single wildcard route: this Worker does its own pathname dispatch
  // (see src/index.mjs) rather than registering one Cloudflare route per
  // surface. More-specific routes on sn-analytics/sn-login-guard/sn-provenance
  // still take precedence over this wildcard (Cloudflare route-matching:
  // "more specific routes take precedence over wildcard routes").
  // 2026-09-25: three dashboard-only routes with NO Worker carve static
  // assets out of this wildcard: juanlentino.com/wp-content/plugins/*,
  // /wp-content/themes/* and /wp-includes/*. Cloudflare refuses every browser
  // prefetch on a Worker-covered URL (503, Cf-Speculation-Refused), one of the
  // two causes of OpenStation's failed app prefetch (Speed Brain off was the
  // other). Wrangler cannot declare a script-less route and a deploy never
  // touches them; see README "Routes".
  // v1.4.0: machine-readership aggregates (family + surface class + day only —
  // no IPs, no raw UAs; see src/machine-readers.mjs for the privacy contract).
  // v1.11.0: SN_MR_RIGHTS is the RULE 3 full-fidelity stream — complete UA,
  // path, Accept and timestamp, but ONLY for rights-surface reads (~80 per
  // 30 days against 17,463 total). A separate dataset because it must never be
  // summed with the aggregate one and answers a different question.
  // v1.25.1: the beacon's per-IP limiter, the Workers Rate Limiting binding
  // (backed by the same infrastructure as rate-limiting rules; spends no
  // dashboard rule). 10 per 10 seconds per client IP on the beacon route only;
  // over it, the route answers 204 and writes nothing (src/webmcp-call.mjs).
  "ratelimits": [
    { "name": "WEBMCP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 10 } }
  ],
  "analytics_engine_datasets": [
    { "binding": "SN_MR", "dataset": "sn_machine_readers" },
    { "binding": "SN_MR_RIGHTS", "dataset": "sn_machine_readers_rights" }
  ],
  "routes": [
    { "pattern": "juanlentino.com/*", "zone_name": "juanlentino.com" }
  ],
  // Runaway ceiling, not a tuning target. Chosen without CPU telemetry.
  // Paid-plan default is 30s (max 5 min) — 3,000× the old Free 10ms cap —
  // so a stuck invocation is now a real bill. 10s is ~3× below that default
  // (bounds a runaway) and far above any plausible legitimate path, including
  // the cron-driven crawler-list sync. Do not tighten it: a ceiling below
  // legitimate use is an outage.
  "limits": { "cpu_ms": 10000 }
}
