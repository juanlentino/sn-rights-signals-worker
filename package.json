{
  "name": "sn-rights-signals-worker",
  "version": "1.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "deploy": "wrangler deploy --var SN_VERSION:$npm_package_version",
    "postdeploy": "node scripts/check-rights-signals.mjs --fresh --await-version $npm_package_version",
    "deploy:ci": "wrangler deploy --var SN_VERSION:$npm_package_version --var SN_COMMIT:${WORKERS_CI_COMMIT_SHA:-$(git rev-parse HEAD 2>/dev/null || echo unknown)}",
    "check:live": "node scripts/check-rights-signals.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "postcss": "^8.5.25",
    "sharp": "^0.35.0",
    "ws": "^8.21.2"
  },
  "dependencies": {
    "jsonwebkey-thumbprint": "^0.1.0",
    "web-bot-auth": "^0.1.3"
  }
}
