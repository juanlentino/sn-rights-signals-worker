{
  "$comment": "The published cohort definition for the Machine Readers surface. DATA, not code — no switch statements anywhere. Served verbatim at https://juanlentino.com/_sn/rights-signals/taxonomy so any number derived from it can be checked against it. See docs/MACHINE-READERS.md in signal-and-noise-tools for the full contract.",
  "taxonomy_version": "1.3.1",
  "effective_date": "2026-08-11",
  "matching": {
    "algorithm": "ordered-substring-case-insensitive",
    "note": "Entries are tested in array order and the FIRST match wins, so specific tokens must precede the generic ones they contain (applebot-extended before applebot; googlebot-image before googlebot). Plain substring rather than regex on purpose: no escaping subtleties, no catastrophic backtracking on a hostile UA, and a reviewer can verify a match by eye. Tokens that risk matching inside an unrelated word carry their punctuation (curl/, axios/, java/)."
  },
  "purpose_vocabulary": {
    "train": "Declared AI training-corpus collection.",
    "search": "Index building for a search product.",
    "retrieval": "Live grounding for an AI answer, agent-initiated.",
    "user": "User-directed single fetch, not a crawl.",
    "archive": "Web archiving.",
    "ops": "Uptime and monitoring.",
    "seo": "Backlink and SEO crawlers.",
    "feed": "RSS and JSON Feed readers.",
    "social": "Link unfurlers and preview fetchers.",
    "security": "Scanners and internet measurement.",
    "dev": "Libraries and scripted clients.",
    "ads": "Advertising and business-product fetches: ad-safety validation and catalogue checks.",
    "unknown": "Unclassified, or a documented agent whose declared purpose has no home in this vocabulary yet."
  },
  "field_contract": {
    "match": "Lowercase token matched as a substring against the lowercased User-Agent.",
    "vendor": "Owning organisation, or null where not identifiable. Independent of purpose.",
    "purpose": "One value from purpose_vocabulary. Reflects the operator's OWN declared function, not our inference about downstream use.",
    "source": "URL of the vendor's own published declaration, or null where no first-party page exists.",
    "declared": "true when purpose comes from the vendor's own published page; false when it rests on third-party reporting. A surface whose claim is 'observed vs declared' must not blur the two.",
    "training_corpus_source": "true when content collected by this agent is known to feed AI training corpora, REGARDLESS of purpose. Keeps the dual role queryable without overloading purpose.",
    "observable": "false for tokens that never appear in a request (robots.txt control tokens). Any observed hit on these is spoofed or synthetic.",
    "note": "Present only where the call is contested or the vendor's declaration is internally mixed.",
    "first_party": "true when the request comes from this site's own tooling. Self-traffic is not readership and headline totals exclude it. Identified from Workers Logs, not guessed."
  },
